# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA suba o .env.local para o Git (já está no .gitignore).

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Console → Credenciais
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Variáveis SECRETAS — nunca use prefixo NEXT_PUBLIC_ nestas ---
# Painel do Supabase → Project Settings → API → service_role key
# Usada só em API Routes (servidor), para gravar em Storage e ignorar RLS quando necessário
SUPABASE_SERVICE_ROLE_KEY=

# Meta for Developers → seu app do WhatsApp → Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio Console → Account SID e Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
